# Copy to .env next to docker-compose.yml.
# PUID/PGID: run `id <your-nas-user>` over SSH and use those numbers.
PUID=1026
PGID=100
# Pin a version for repeatable deploys (e.g. 0.1.0). "latest" follows the newest release.
TAG=latest

# Optional DSM origin and the DSM users who can manage brain settings.
# DSM_URL=http://192.168.1.158:5000
# DSM_ADMIN_USERS=your-dsm-name
# SECURE_COOKIES=true
# OLLAMA_DISCOVERY_CIDR=192.168.1.0/24
# Mount a separate share in Compose and list its in-container path here.
# LAB_AGENTS_MOUNTS=[{"id":"photos","directory":"/shares/photos","mode":"read"}]
